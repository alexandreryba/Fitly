{
  "manifest_version": 3,
  "name": "Fitly",
  "version": "1.1.0",
  "key": "",
  "description": "Pré-remplit les formulaires de candidature : automatiquement dans les onglets ouverts par Fitly, et en un clic (bouton ou Alt+Maj+P) sur n'importe quelle page de candidature. Ajoute aussi à Fitly les offres de la page consultée (sur clic). N'envoie jamais de candidature ; ne communique qu'avec ton PC.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Ajouter à Fitly",
    "default_popup": "popup.html"
  },
  "commands": {
    "manual-fill": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pré-remplir le formulaire de cette page"
    }
  }
}
